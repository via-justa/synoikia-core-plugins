{
  "id": "truenas",
  "name": "TrueNAS",
  "version": "0.1.1",
  "sdk": "^0.2.0",
  "description": "Search/execute over the TrueNAS JSON-RPC API, catalog from core.get_methods.",
  "entry": "dist/index.js",
  "binding": {
    "namespace": "truenas",
    "functions": ["call"]
  },
  "labels": {
    "operation": "Method",
    "operations": "Methods"
  },
  "connection": {
    "schema": {
      "type": "object",
      "required": ["baseUrl", "apiKey"],
      "properties": {
        "baseUrl": {
          "type": "string",
          "format": "uri",
          "title": "Base URL"
        },
        "apiKey": {
          "type": "string",
          "title": "API key",
          "writeOnly": true
        },
        "verifyTls": {
          "type": "boolean",
          "title": "Verify TLS certificate",
          "default": true
        }
      }
    },
    "ui": {
      "baseUrl": {
        "widget": "url",
        "placeholder": "https://truenas.internal.lan"
      },
      "apiKey": {
        "widget": "secret",
        "help": "Credentials → API Keys. FULL_ADMIN is the accepted operating assumption."
      },
      "verifyTls": {
        "widget": "bool"
      }
    },
    "help": "Needs **TrueNAS 25.04 or newer** (JSON-RPC API at `/api/current`).\n\n1. In TrueNAS: *Credentials → API Keys → Add*. FULL_ADMIN is assumed; a narrower role works for what it allows.\n2. Enter the base URL (`https://truenas.internal.lan`) and the key, then **Test connection**.\n3. Keep *Verify TLS* on unless TrueNAS still uses its self-signed certificate on a trusted network.\n\nAfter the first sync every group is at **Read**; raise groups on the Access page as needed."
  },
  "sensitiveKeys": [
    "apiKey",
    "api_key",
    "password",
    "passphrase",
    "bindpw",
    "privatekey",
    "private_key",
    "monpwd",
    "community",
    "host_rsa_key",
    "host_ecdsa_key",
    "host_ed25519_key"
  ],
  "network": {
    "hosts": ["{{connection.baseUrl}}"]
  },
  "matchProfiles": {
    "dataset-name-prefix": [
      {
        "field": "/0/name",
        "label": "Name prefix",
        "op": "prefix",
        "widget": "prefix"
      }
    ],
    "app-name-in": [
      {
        "field": "/0",
        "label": "App in",
        "op": "in",
        "widget": "multiselect",
        "optionsSource": "installed-apps"
      }
    ]
  }
}
